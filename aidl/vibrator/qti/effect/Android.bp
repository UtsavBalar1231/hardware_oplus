soong_config_module_type {
    name: "oplus_vibrator_effect_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "OPLUS_VIBRATOR_EFFECT",
    bool_variables: ["ENABLE_DYNAMIC_EFFECTS"],
    properties: [
        "cflags",
        "srcs",
        "shared_libs",
    ],
}

oplus_vibrator_effect_cc_defaults {
    name: "vibrator_dynamic_effect_defaults",
    soong_config_variables: {
        ENABLE_DYNAMIC_EFFECTS: {
            cflags: ["-DENABLE_DYNAMIC_EFFECTS"],
            srcs: ["DynamicEffectLoader.cpp"],
            shared_libs: [
                "libandroid-base",
                "libjsoncpp",
            ],
        },
    },
}

cc_library_shared {
    name: "liboplusvibratoreffect",
    defaults: [
        "oplus_lineage_vibrator_effect_defaults",
        "vibrator_dynamic_effect_defaults",
    ],
    vendor: true,
    srcs: [
        "effect.cpp",
    ],
    shared_libs: [
        "libcutils",
        "libutils",
    ],
}
